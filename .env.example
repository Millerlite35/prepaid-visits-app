# Copy this file to .env.local and fill in the values, then restart "npm run dev".
# .env.local is never committed to Git. THIS file is committed, so never put real values here.
# Supabase dashboard: the "Connect" button shows the project URL;
# Project Settings > API Keys shows the two keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co (not secret)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_) or the legacy "anon" key.
# Safe to expose to browsers: row-level security decides what it can see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where this app is running. Used in links inside emails (e.g. "confirm your account").
# Must also be allowed in Supabase: Authentication > URL Configuration.
SITE_URL=http://localhost:3000

# SECRET. Secret key (starts with sb_secret_) or the legacy "service_role" key.
# Server only. It bypasses row-level security. Never paste it into a chat or commit it.
SUPABASE_SECRET_KEY=

# SECRET. Stripe secret key, TEST MODE only (starts with sk_test_).
# Stripe dashboard (Test mode on) > Developers > API keys > Secret key.
# The app refuses live keys (sk_live_) unless ALLOW_LIVE_PAYMENTS=true.
STRIPE_SECRET_KEY=
